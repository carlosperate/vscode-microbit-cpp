{
	// The desktop entry really does run in node, so this is the one part of `src/`
	// that gets node's types: everywhere else they would let `process`, `Buffer`
	// and `__dirname` compile and then throw in the Web Worker. It sits here
	// rather than at the root so tsserver picks it up for these files too.
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2020"],
		"types": ["vscode", "node"]
	},
	// The root's `exclude` is this very folder, and it is inherited, so it has to
	// be replaced rather than extended.
	"exclude": ["../../node_modules", "../../dist"],
	"include": ["**/*.ts"]
}
